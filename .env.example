# PostgreSQL connection string used by Prisma.
# Local dev with the provided docker-compose.yml:
DATABASE_URL="postgresql://postgres:lamoucherie_dev@localhost:5432/la_moucherie"
# Same database, but the NON-pooled host — on Neon this is auto-provided as
# DATABASE_URL_UNPOOLED by the Vercel integration (for every environment, not
# just Production). Migrations take a session-scoped advisory lock that a
# transaction-mode pooler cannot hold, so running them through the pooled URL
# fails with "P1002 ... timed out trying to acquire a postgres advisory lock".
# A plain local Postgres has no pooler, so this is the same value.
DATABASE_URL_UNPOOLED="postgresql://postgres:lamoucherie_dev@localhost:5432/la_moucherie"

# Stripe API keys — https://dashboard.stripe.com/apikeys (use test keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook signing secret — from `stripe listen` locally, or the Dashboard webhook endpoint in production
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public site URL, used to build absolute links (order confirmation, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Social links. Leave blank to hide the icon in the footer — only TikTok for now.
# Full profile URL, e.g. "https://www.tiktok.com/@lamoucherie"
NEXT_PUBLIC_TIKTOK_URL=""

# Auth.js session signing secret — generate your own with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Email (Resend — https://resend.com). Leave RESEND_API_KEY blank and the site
# still works: order confirmations, contact alerts and password-reset links are
# logged instead of sent, and nothing errors.
RESEND_API_KEY=""
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM="La Moucherie <commandes@lamoucherie.ca>"
# Where new-order and contact-form alerts go.
OWNER_EMAIL=""

# Shared secret Vercel sends with scheduled cron calls (any long random string).
CRON_SECRET=""

# Canada Post Rating API (optional). Without these the tracked rate falls back
# to the static zone table in src/lib/shipping.ts — the shop works either way.
# Get them from the Canada Post Developer Program; the pair is the API key
# username and password for one environment.
CANADA_POST_API_USERNAME=""
CANADA_POST_API_PASSWORD=""
# "dev" hits the Canada Post test gateway, "prod" the live one. The credentials
# differ between the two — a dev key against the prod host returns 401.
CANADA_POST_ENV="dev"
# Only needed for contract (commercial) rates. Leave empty for regular pricing.
CANADA_POST_CUSTOMER_NUMBER=""

# Who can open the operational pages (e.g. /api/admin/canada-post-check) by
# signing in, rather than with the CRON_SECRET header. Comma-separated;
# defaults to OWNER_EMAIL when unset.
ADMIN_EMAILS=""
