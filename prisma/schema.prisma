generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through Neon's pooled host: many short-lived serverless
  // connections are exactly what a pooler is for.
  url       = env("DATABASE_URL")
  // Migrations must not. `prisma migrate deploy` takes a session-scoped Postgres
  // advisory lock, and a transaction-mode pooler can't hold one, so every deploy
  // died with "P1002 … timed out trying to acquire a postgres advisory lock".
  // DATABASE_URL_UNPOOLED is the Neon Vercel integration's own non-pooled URL —
  // it auto-populates for Production AND every Preview branch, unlike a
  // hand-added DIRECT_URL which only exists where someone remembered to type it
  // in (that gap is exactly what broke every preview build).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ProductCategory {
  DRY_FLY
  NYMPH
  STREAMER
  WET_FLY
  MATERIAL
  TOOL
  KIT
  // Curated multi-fly boxes. Priced as a bundle, so they sit outside the
  // per-fly bulk tiers rather than being discounted twice.
  ASSORTMENT
}

// Where a material sits in the recipe, roughly in tying order. Doubles as the
// grouping for the consolidated shopping list on the production run sheet.
enum MaterialCategory {
  HOOK
  BEAD_WEIGHT
  THREAD
  TAIL
  BODY
  RIB
  THORAX
  HACKLE
  WING
  HEAD
  ADHESIVE
  OTHER
}

// A material as it exists in the bin, not as it appears in one recipe — two
// patterns calling for black 8/0 thread must point at the SAME row, or the
// shopping list can't roll them up into one line.
model Material {
  id           String            @id @default(cuid())
  nameFr       String
  nameEn       String
  category     MaterialCategory
  // Brand, spec, where it's bought. Never rendered publicly: this is sourcing.
  supplierNote String?
  products     ProductMaterial[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([category, nameEn])
  @@index([category])
}

model ProductMaterial {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  // Restrict, not Cascade: deleting a material that recipes still reference
  // should fail loudly rather than quietly gutting them.
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialId String
  // How this pattern uses it — "olive, size 14", "2.5mm gold". The Material row
  // stays generic so it can still group.
  specFr     String?
  specEn     String?
  // Set for things consumed one-per-fly (hook, bead) so the run sheet can total
  // them against the number of flies to tie. Null for thread, dubbing, hackle
  // and anything else where "you either have it or you don't".
  perFlyQty  Int?
  // Tying order, bottom of the hook up.
  position   Int      @default(0)

  @@unique([productId, materialId])
  @@index([productId])
}

// How much of the insect was actually on the water. Deliberately coarse: an
// angler can answer this honestly from memory, which "how many per minute"
// invites them to invent.
enum HatchIntensity {
  NONE
  SPARSE
  STEADY
  HEAVY
}

enum WaterLevel {
  LOW
  NORMAL
  HIGH
}

enum WaterClarity {
  CLEAR
  STAINED
  MUDDY
}

enum SkyCondition {
  SUNNY
  PARTLY_CLOUDY
  OVERCAST
  RAIN
}

/// An angler's report of what was hatching, submitted from the public form.
///
/// Deliberately NOT a FishingReport: that model is bilingual throughout
/// (titleFr/titleEn, bodyFr/bodyEn…) because the shop writes both languages.
/// A visitor writes one. Keeping them apart also means this data stays
/// structured rather than prose, which is what lets it be aggregated later
/// ("Hendrickson reported on four rivers in ten days") instead of only read.
model HatchReport {
  id         String @id @default(cuid())
  anglerName String
  /// Stored so the shop can follow up or thank someone. Never rendered
  /// publicly, and never a marketing consent on its own — see consentSource
  /// on NewsletterSubscriber.
  email      String
  locale     String @default("fr")

  water      FishingWater? @relation(fields: [waterId], references: [id], onDelete: SetNull)
  waterId    String?
  /// Most of Québec isn't in FishingWater. Without this the form dead-ends for
  /// anyone fishing an unnamed river — it is also the only free-text field
  /// here, so it carries the moderation weight.
  waterOther String?
  observedOn DateTime

  /// Matches a Hatch id in src/lib/hatches.ts. Not a foreign key, because that
  /// catalogue lives in code rather than the database — validated on write,
  /// which makes those ids permanent: renaming one orphans every report
  /// pointing at it.
  hatchId   String?
  hookSize  Int?
  species   FishSpecies?
  intensity HatchIntensity?

  waterLevel   WaterLevel?
  waterClarity WaterClarity?
  sky          SkyCondition?
  waterTempC   Float?

  /// The fly that actually worked, when they picked one.
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  note String?

  /// Nothing renders until it is approved by hand, same as CatchPhoto.
  approved  Boolean  @default(false)
  /// Filed by the shop rather than a visitor. Auto-approved, and labelled as
  /// such on the page rather than passed off as a stranger's report.
  fromShop  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved, observedOn])
  @@index([hatchId, observedOn])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  FULFILLED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Product {
  id              String            @id @default(cuid())
  slug            String            @unique
  nameFr          String
  nameEn          String
  descriptionFr   String
  descriptionEn   String
  category        ProductCategory
  basePriceCents  Int
  currency        String            @default("cad")
  images          String[]          @default([])
  active          Boolean           @default(true)
  featured        Boolean           @default(false)
  species         FishSpecies[]     @default([])
  seasons         FishingSeason[]   @default([])
  waterTypes      WaterType[]       @default([])
  techniques      Technique[]       @default([])
  imitatesFr      String[]          @default([])
  imitatesEn      String[]          @default([])
  howToFishFr     String?
  howToFishEn     String?
  proTipFr        String?
  proTipEn        String?
  waters          FishingWater[]    @relation("ProductWaters")
  reports         FishingReport[]   @relation("ReportProducts")
  catches         CatchPhoto[]
  hatchReports    HatchReport[]
  materials       ProductMaterial[]
  // Recipes are seeded from the standard published dressing for each pattern,
  // which is a starting point, not how this bench actually ties it. Nothing is
  // shown to customers until someone has checked that fly's recipe and flipped
  // this on.
  materialsPublic Boolean           @default(false)
  variants        ProductVariant[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([category])
  @@index([active, featured])
}

model Review {
  id               String       @id @default(cuid())
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  // Nullable so pre-existing/seeded reviews survive, and so a deleted account
  // doesn't take its reviews down with it. New reviews always set this.
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId           String?
  customerName     String
  email            String
  rating           Int
  title            String
  body             String
  locale           String       @default("fr")
  // What was actually on the line when the fly worked — all optional, since
  // most reviewers will only ever fill in the star rating and a comment.
  speciesCaught    FishSpecies?
  waterName        String?
  hookSize         String?
  conditions       String?
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  helpfulCount     Int          @default(0)
  notHelpfulCount  Int          @default(0)
  votes            ReviewVote[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
}

/// One "was this helpful" vote. Keyed by a hashed visitor identifier rather
/// than a user account — reviews are public and voting shouldn't require
/// signing in — so this exists purely to stop the same visitor voting twice,
/// not to identify anyone.
model ReviewVote {
  id        String   @id @default(cuid())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String
  voterKey  String
  helpful   Boolean
  createdAt DateTime @default(now())

  @@unique([reviewId, voterKey])
  @@index([reviewId])
}

model ProductVariant {
  id         String      @id @default(cuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  nameFr     String
  nameEn     String
  sku        String      @unique
  priceCents Int?
  stock      Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
}

model Order {
  id                    String      @id @default(cuid())
  stripePaymentIntentId String      @unique
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                String?
  email                 String
  customerName          String
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingProvince      String
  shippingPostalCode    String
  shippingCountry       String      @default("CA")
  // Recorded per order so a past order can still be read back correctly after
  // the rates in src/lib/shipping.ts change.
  shippingMethod        String      @default("TRACKED")
  // Which Canada Post service was actually bought, when the customer picked
  // among live tiers (Regular/Expedited/Xpresspost/Priority). Null for
  // Lettermail and for the zone-table fallback, neither of which has tiers.
  shippingServiceCode   String?
  shippingServiceName   String?
  shippingCents         Int         @default(0)
  // What the customer asked for in their own words, and what the bulk tiers
  // took off — both recorded so an old order reads correctly after the rules change.
  notes                 String?
  discountCents         Int         @default(0)
  // Lets an abandoned-cart email rebuild the basket without exposing order ids.
  recoveryToken         String?     @unique
  recoveryEmailSentAt   DateTime?
  amountTotalCents      Int
  currency              String      @default("cad")
  status                OrderStatus @default(PENDING)
  locale                String      @default("fr")
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([email])
  @@index([userId])
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String
  emailVerified      DateTime?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingProvince   String?
  shippingPostalCode String?
  shippingCountry    String?
  orders             Order[]
  reviews            Review[]
  resetTokens        PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // Only the hash is stored: a leaked database row must not be usable to seize
  // an account. The raw token exists solely in the emailed link.
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  locale           String    @default("fr")
  // Plaintext, unlike PasswordResetToken's hash — this link has to keep
  // working in every future campaign email, not just once right after it's
  // issued, so there's no stored secret to hash it against.
  unsubscribeToken String    @unique
  // CASL requires express consent for commercial email, and requires you to
  // be able to show how it was obtained. A bare timestamp cannot answer that;
  // this names the form the person actually ticked.
  consentSource    String    @default("newsletter_form")
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([unsubscribedAt])
}

/// A log line per campaign sent, mostly so the admin dashboard can show what
/// already went out rather than risk a double-send with no record of it.
model NewsletterCampaign {
  id             String   @id @default(cuid())
  subjectFr      String
  subjectEn      String
  recipientCount Int
  sentAt         DateTime @default(now())
}

/// A tying to-do list, not a catalog entry — patterns worth adding once
/// they're actually tied, priced and photographed. Lets the admin dashboard
/// answer "what should I tie next" without inventing a half-real Product row
/// (no price, no photo, nothing to sell yet) for something that isn't real
/// stock. Deleted once the real Product exists — there's no "done" flag,
/// because turning into a Product *is* done.
model PlannedFly {
  id        String          @id @default(cuid())
  nameFr    String
  nameEn    String
  category  ProductCategory
  species   FishSpecies[]   @default([])
  notes     String?
  createdAt DateTime        @default(now())
}

model OrderItem {
  id                String          @id @default(cuid())
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId         String?
  nameSnapshotFr    String
  nameSnapshotEn    String
  variantSnapshotFr String          @default("")
  variantSnapshotEn String          @default("")
  sku               String
  unitPriceCents    Int
  quantity          Int

  @@index([orderId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// --- Angler-facing taxonomy -------------------------------------------------
// Customers think in fish, water and season; the shop was only organised by fly
// type, which is how a tyer thinks. These let a fly be found the way it's
// actually chosen.

enum FishSpecies {
  BROOK_TROUT
  BROWN_TROUT
  RAINBOW_TROUT
  LANDLOCKED_SALMON
  ATLANTIC_SALMON
  SMALLMOUTH_BASS
  LARGEMOUTH_BASS
  NORTHERN_PIKE
  WALLEYE
}

enum FishingSeason {
  SPRING
  SUMMER
  FALL
}

enum WaterType {
  RIVER
  STREAM
  LAKE
  STILLWATER
}

enum Technique {
  DEAD_DRIFT
  STRIP
  SWING
  SKATE
  NYMPHING
  TROLLING
}

/// A named piece of water. The sharpest version of the Québec position: no
/// competitor outside the province can credibly claim these.
model FishingWater {
  id            String          @id @default(cuid())
  slug          String          @unique
  nameFr        String
  nameEn        String
  regionFr      String
  regionEn      String
  descriptionFr String
  descriptionEn String
  featured      Boolean         @default(false)
  products      Product[]       @relation("ProductWaters")
  reports       FishingReport[]
  catches       CatchPhoto[]
  hatchReports  HatchReport[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// Short seasonal notes on what is working where. The reason to come back to
/// the site weekly rather than once.
model FishingReport {
  id           String        @id @default(cuid())
  slug         String        @unique
  titleFr      String
  titleEn      String
  bodyFr       String
  bodyEn       String
  conditionsFr String
  conditionsEn String
  water        FishingWater? @relation(fields: [waterId], references: [id], onDelete: SetNull)
  waterId      String?
  products     Product[]     @relation("ReportProducts")
  published    Boolean       @default(false)
  publishedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([published, publishedAt])
}

/// Customer catch photos. Curated by hand rather than uploaded: approval is the
/// whole point, and it avoids running an image-upload pipeline for a handful of
/// photos a month.
model CatchPhoto {
  id           String        @id @default(cuid())
  imageUrl     String
  // The post itself, so the card can credit and link back to it instead of
  // embedding a live feed — the whole point of curating by hand from the
  // #LaMoucherie hashtag instead of trusting an auto-embed to pick well.
  instagramUrl String?
  // Optional: an admin can leave it blank and let the Instagram fetch (or a
  // generic "anonymous angler" fallback on display) fill the gap.
  anglerName   String?
  captionFr    String?
  captionEn    String?
  species      FishSpecies?
  water        FishingWater? @relation(fields: [waterId], references: [id], onDelete: SetNull)
  waterId      String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  sizeLabel    String?
  conditionsFr String?
  conditionsEn String?
  approved     Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([approved, createdAt])
}
