generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through Neon's pooled host: many short-lived serverless
  // connections are exactly what a pooler is for.
  url      = env("DATABASE_URL")
  // Migrations must not. `prisma migrate deploy` takes a session-scoped Postgres
  // advisory lock, and a transaction-mode pooler can't hold one, so every deploy
  // died with "P1002 … timed out trying to acquire a postgres advisory lock".
  // This is the same Neon connection string with `-pooler` removed from the host.
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  DRY_FLY
  NYMPH
  STREAMER
  WET_FLY
  MATERIAL
  TOOL
  KIT
  // Curated multi-fly boxes. Priced as a bundle, so they sit outside the
  // per-fly bulk tiers rather than being discounted twice.
  ASSORTMENT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  FULFILLED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  nameFr          String
  nameEn          String
  descriptionFr   String
  descriptionEn   String
  category        ProductCategory
  basePriceCents  Int
  currency        String          @default("cad")
  images          String[]        @default([])
  active          Boolean         @default(true)
  featured        Boolean         @default(false)
  species         FishSpecies[]   @default([])
  seasons         FishingSeason[] @default([])
  waterTypes      WaterType[]     @default([])
  techniques      Technique[]     @default([])
  imitatesFr      String[]        @default([])
  imitatesEn      String[]        @default([])
  howToFishFr     String?
  howToFishEn     String?
  proTipFr        String?
  proTipEn        String?
  waters          FishingWater[]  @relation("ProductWaters")
  reports         FishingReport[] @relation("ReportProducts")
  catches         CatchPhoto[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([category])
  @@index([active, featured])
}

model Review {
  id               String       @id @default(cuid())
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  // Nullable so pre-existing/seeded reviews survive, and so a deleted account
  // doesn't take its reviews down with it. New reviews always set this.
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId           String?
  customerName     String
  email            String
  rating           Int
  title            String
  body             String
  locale           String       @default("fr")
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
}

model ProductVariant {
  id          String      @id @default(cuid())
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  nameFr      String
  nameEn      String
  sku         String      @unique
  priceCents  Int?
  stock       Int         @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([productId])
}

model Order {
  id                    String      @id @default(cuid())
  stripePaymentIntentId String      @unique
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                String?
  email                 String
  customerName          String
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingProvince      String
  shippingPostalCode    String
  shippingCountry       String      @default("CA")
  // Recorded per order so a past order can still be read back correctly after
  // the rates in src/lib/shipping.ts change.
  shippingMethod        String      @default("TRACKED")
  shippingCents         Int         @default(0)
  // What the customer asked for in their own words, and what the bulk tiers
  // took off — both recorded so an old order reads correctly after the rules change.
  notes                 String?
  discountCents         Int         @default(0)
  // Lets an abandoned-cart email rebuild the basket without exposing order ids.
  recoveryToken         String?     @unique
  recoveryEmailSentAt   DateTime?
  amountTotalCents      Int
  currency              String      @default("cad")
  status                OrderStatus @default(PENDING)
  locale                String      @default("fr")
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([email])
  @@index([userId])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  emailVerified      DateTime?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingProvince   String?
  shippingPostalCode String?
  shippingCountry    String?
  orders             Order[]
  reviews            Review[]
  resetTokens        PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // Only the hash is stored: a leaked database row must not be usable to seize
  // an account. The raw token exists solely in the emailed link.
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model OrderItem {
  id              String          @id @default(cuid())
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId       String?
  nameSnapshotFr  String
  nameSnapshotEn  String
  variantSnapshotFr String        @default("")
  variantSnapshotEn String        @default("")
  sku             String
  unitPriceCents  Int
  quantity        Int

  @@index([orderId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// --- Angler-facing taxonomy -------------------------------------------------
// Customers think in fish, water and season; the shop was only organised by fly
// type, which is how a tyer thinks. These let a fly be found the way it's
// actually chosen.

enum FishSpecies {
  BROOK_TROUT
  BROWN_TROUT
  RAINBOW_TROUT
  LANDLOCKED_SALMON
  ATLANTIC_SALMON
  SMALLMOUTH_BASS
  LARGEMOUTH_BASS
  NORTHERN_PIKE
  WALLEYE
}

enum FishingSeason {
  SPRING
  SUMMER
  FALL
}

enum WaterType {
  RIVER
  STREAM
  LAKE
  STILLWATER
}

enum Technique {
  DEAD_DRIFT
  STRIP
  SWING
  SKATE
  NYMPHING
  TROLLING
}

/// A named piece of water. The sharpest version of the Québec position: no
/// competitor outside the province can credibly claim these.
model FishingWater {
  id            String          @id @default(cuid())
  slug          String          @unique
  nameFr        String
  nameEn        String
  regionFr      String
  regionEn      String
  descriptionFr String
  descriptionEn String
  featured      Boolean         @default(false)
  products      Product[]       @relation("ProductWaters")
  reports       FishingReport[]
  catches       CatchPhoto[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// Short seasonal notes on what is working where. The reason to come back to
/// the site weekly rather than once.
model FishingReport {
  id            String        @id @default(cuid())
  slug          String        @unique
  titleFr       String
  titleEn       String
  bodyFr        String
  bodyEn        String
  conditionsFr  String
  conditionsEn  String
  water         FishingWater? @relation(fields: [waterId], references: [id], onDelete: SetNull)
  waterId       String?
  products      Product[]     @relation("ReportProducts")
  published     Boolean       @default(false)
  publishedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([published, publishedAt])
}

/// Customer catch photos. Curated by hand rather than uploaded: approval is the
/// whole point, and it avoids running an image-upload pipeline for a handful of
/// photos a month.
model CatchPhoto {
  id         String        @id @default(cuid())
  imageUrl   String
  anglerName String
  captionFr  String?
  captionEn  String?
  species    FishSpecies?
  water      FishingWater? @relation(fields: [waterId], references: [id], onDelete: SetNull)
  waterId    String?
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  approved   Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([approved, createdAt])
}
